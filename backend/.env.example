# Core Settings
API_KEY=your_secure_api_key_here
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Application Config
RATE_LIMIT=100/minute
CACHE_REFRESH_INTERVAL=5
QUEUE_MAX_SIZE=10000
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Database
DATABASE_URL=sqlite:///data/firewall.db

# Safety: when true, rules are logged but packets are not dropped/reset (safe first run).
# Set to false only if you intend this process to intercept traffic as Administrator.
MONITOR_ONLY=true

# CORS Configuration
# For production, specify exact origins instead of wildcard
# Example: CORS_ORIGINS='["http://localhost:5173", "https://yourdomain.com"]'
# Development: CORS_ORIGINS='["*"]'
CORS_ORIGINS='["http://localhost:5173"]'

# Threat Intelligence
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
